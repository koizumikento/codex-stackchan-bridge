{
    "names": {
        "rmw_microxrcedds": {
            "cmake-args": [
                "-DRMW_UXRCE_MAX_SERVICES=16",
                "-DRMW_UXRCE_MAX_PUBLISHERS=20",
                "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=4",
                "-DRMW_UXRCE_MAX_CLIENTS=8",
                "-DRMW_UXRCE_MAX_HISTORY=16",
                "-DRMW_UXRCE_STREAM_HISTORY_INPUT=8",
                "-DRMW_UXRCE_STREAM_HISTORY_OUTPUT=8",
                "-DRMW_UXRCE_MAX_WAIT_SETS=8",
                "-DRMW_UXRCE_MAX_GUARD_CONDITION=8",
                "-DRMW_UXRCE_TOPIC_NAME_MAX_LENGTH=96"
            ]
        }
    }
}
